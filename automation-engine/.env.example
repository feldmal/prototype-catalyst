# Optional PostgreSQL connection. Leave unset to use local SQLite.
# For local Docker Compose PostgreSQL, use the profile in compose.postgres.yaml.
# Never commit real production credentials.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

# Optional Cloudflare R2 settings. Keep this bucket private.
# Create an R2 API token with Object Read & Write permissions for this bucket only.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=prototype-catalyst-private
# R2_MAX_UPLOAD_MB=1024
# Generate a long random token for the API's temporary bearer-token protection.
# R2_UPLOAD_API_TOKEN=replace-with-a-long-random-secret
